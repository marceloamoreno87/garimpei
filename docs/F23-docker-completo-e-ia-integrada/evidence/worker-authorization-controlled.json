    "static_reverse_body_exactly_historical_0027": true,
    "script": "from pathlib import Path\nfrom tempfile import TemporaryDirectory\nfrom tests.factories.gold_driver import GoldDriver\n\nSCRIPT = r\"\"\"\nimport hashlib,json\nfrom io import StringIO\nfrom django.core.management import call_command\nfrom django.db import connection\nfrom garimpei.infra.persistence.gold_models import GoldPolicyAdoption\n\ndef function():\n with connection.cursor() as cursor:\n  cursor.execute(\"SELECT oid,pg_get_functiondef(oid) FROM pg_proc WHERE proname='garimpei_gold_authorization_guard'\")\n  return cursor.fetchone()\ndef trigger():\n with connection.cursor() as cursor:\n  cursor.execute(\"SELECT oid,tgfoid FROM pg_trigger WHERE tgname='garimpei_gold_authorization'\")\n  return cursor.fetchone()\nbefore=function()\noriginal_trigger=trigger()\ndata=list(GoldPolicyAdoption.objects.values())\nassert 'expected_policy' in before[1]\ncall_command('migrate','runtime','0030',stdout=StringIO(),verbosity=0)\nreverse=function()\nassert reverse[0]==before[0] and trigger()==original_trigger\nassert 'expected_policy' not in reverse[1] and \"NEW.gold_policy_verified IS DISTINCT FROM 'gold-alert-v1'\" in reverse[1]\nassert 'garimpei.integrity_restore' in reverse[1] and 'runtime_recoverybarrier' in reverse[1]\nassert list(GoldPolicyAdoption.objects.values())==data\ncall_command('migrate','runtime','0031',stdout=StringIO(),verbosity=0)\nafter=function()\nassert after==before and trigger()==original_trigger\nassert list(GoldPolicyAdoption.objects.values())==data\nprint('CONTROLLED_REVERSE_EVIDENCE='+json.dumps(dict(\n cycle=['0031','0030','0031'],forward_sha256=hashlib.sha256(before[1].encode()).hexdigest(),\n restored_forward_sha256=hashlib.sha256(after[1].encode()).hexdigest(),\n reverse_sha256=hashlib.sha256(reverse[1].encode()).hexdigest(),\n function_oid_preserved=True,trigger_oid_preserved=True,gold_policy_data_preserved=True,\n restoration_barrier_preserved=True,model_calls=0,posts=0)))\n\"\"\"\nwith TemporaryDirectory(prefix='f23-guard-reverse-') as directory:\n    driver=GoldDriver(Path(directory))\n    try:\n        print(driver.shell(SCRIPT))\n    finally:\n        driver.close()\n",
    "script_sha256": "b88c402e8440d628fd4fb857a7167bc36d63c81d0edbac342b91ccef22058c2d"
