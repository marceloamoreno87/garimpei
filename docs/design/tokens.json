{
  "meta": {
    "name": "Garimpei — Mineral",
    "version": "0.2.0",
    "defaultTheme": "editorial",
    "status": "Direção clara/editorial e composição editorial escolhidas; componentes e fluxos ainda em proposta navegável"
  },
  "primitives": {
    "paper": "#F6F8F3",
    "white": "#FFFFFF",
    "ink": "#1B2B23",
    "muted": "#596B5E",
    "line": "#DBE3D7",
    "control": "#879888",
    "mineral": "#285B40",
    "mineralHover": "#1D4931",
    "mineralSoft": "#E7EFE0",
    "mineralInk": "#204C33",
    "leaf": "#D8E7BC",
    "amber": "#79520F",
    "amberSoft": "#FCF1D9",
    "red": "#A33E32",
    "redSoft": "#FAECE8",
    "slate": "#3D5B70",
    "slateSoft": "#EAF1F6",
    "night": "#14221A",
    "nightSurface": "#1E3024",
    "nightRaised": "#2A3E2E",
    "nightText": "#EDF2E5",
    "nightMuted": "#BAC9B8",
    "nightLine": "#425B47"
  },
  "tokens": {
    "color-bg": "{paper}",
    "color-surface": "{white}",
    "color-raised": "{paper}",
    "color-text": "{ink}",
    "color-muted": "{muted}",
    "color-line": "{line}",
    "color-control": "{control}",
    "color-primary": "{mineral}",
    "color-primary-hover": "{mineralHover}",
    "color-on-primary": "{white}",
    "color-accent-soft": "{mineralSoft}",
    "color-accent-text": "{mineralInk}",
    "color-leaf": "{leaf}",
    "color-warning": "{amber}",
    "color-warning-bg": "{amberSoft}",
    "color-danger": "{red}",
    "color-danger-bg": "{redSoft}",
    "color-info": "{slate}",
    "color-info-bg": "{slateSoft}",
    "color-focus": "{mineral}",
    "font-body": "'Manrope', sans-serif",
    "font-display": "'Bricolage Grotesque', sans-serif",
    "font-xs": "0.75rem",
    "font-sm": "0.875rem",
    "font-base": "1rem",
    "font-md": "1.125rem",
    "font-lg": "1.5rem",
    "font-xl": "2rem",
    "font-title": "2.625rem",
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "20px",
    "space-6": "24px",
    "space-8": "32px",
    "space-10": "40px",
    "space-12": "48px",
    "space-16": "64px",
    "radius-control": "10px",
    "radius-card": "16px",
    "radius-feature": "24px",
    "radius-pill": "999px",
    "layout-sidebar": "14rem",
    "layout-max": "1440px",
    "layout-touch": "44px",
    "layout-mobile": "720px",
    "layout-tablet": "1100px",
    "motion-fast": "120ms",
    "motion-base": "180ms",
    "motion-ease": "cubic-bezier(.2,.8,.2,1)",
    "shadow-overlay": "0 10px 32px #1B2B231A",
    "layout-medium": "1250px",
    "layout-wide": "1600px",
    "layout-sidebar-compact": "11.5rem"
  },
  "themes": {
    "editorial": {},
    "compact": {
      "radius-feature": "16px"
    },
    "night": {
      "color-bg": "{night}",
      "color-surface": "{nightSurface}",
      "color-raised": "{nightRaised}",
      "color-text": "{nightText}",
      "color-muted": "{nightMuted}",
      "color-line": "{nightLine}",
      "color-control": "{nightMuted}",
      "color-primary": "{leaf}",
      "color-primary-hover": "{white}",
      "color-on-primary": "{night}",
      "color-accent-soft": "{nightRaised}",
      "color-accent-text": "{leaf}",
      "color-focus": "{leaf}",
      "color-warning": "{amberSoft}",
      "color-warning-bg": "{amber}",
      "color-danger": "{redSoft}",
      "color-danger-bg": "{red}",
      "color-info": "{slateSoft}",
      "color-info-bg": "{slate}"
    }
  }
}
