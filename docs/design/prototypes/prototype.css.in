th:max-content;border-radius:var(--radius-control);max-width:calc(100vw - 20px)}.prototype-bar .icon-button{width:36px}.variant-label{min-width:96px}.prototype-separator{margin:0 5px}.scenario-label select{max-width:118px;font-size:11px;padding-left:4px}.prototype-inspector summary{width:30px}.prototype-inspector>div{right:0;bottom:72px;width:calc(100vw - 24px)}.toast{right:16px;bottom:92px;padding:14px 16px}.detail-image{aspect-ratio:1.35}.detail-layout{gap:12px}.valuation-panel{padding:24px 20px}.detail-description h2,.comparables h2,.new-reference h2{font-size:22px}.reference-row{gap:14px;align-items:start;font-size:var(--font-xs)}.reference-row strong{font-size:var(--font-xs)}.reference-row small{font-size:11px}.cost-breakdown>div{font-size:var(--font-sm)}.cost-breakdown dt{max-width:19ch}.cost-breakdown dd{font-size:var(--font-xs)}.cost-breakdown dt span{font-size:var(--font-xs)}.profit-total strong{font-size:22px}.form-section{padding:24px 20px}.form-section h2{font-size:23px}.add-product>.btn{width:100%}.category-options{grid-template-columns:1fr}.two-fields{grid-template-columns:1fr}.form-actions>.btn{width:100%}.helper-panel h2{font-size:27px}.alert-row{gap:12px}.alert-icon{width:30px;height:30px}.alert-icon .icon{width:17px;height:17px}.alert-row .row{gap:10px}.alert-row h3{font-size:var(--font-sm);line-height:1.5}.message-panel{padding:20px}.swatch-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.display-example{font-size:34px}.number-example{font-size:28px}.comparison-wrap{border-radius:var(--radius-control)}.analysis-item{gap:10px;flex-wrap:wrap}.analysis-item img{width:50px;height:58px}.analysis-item strong{font-size:var(--font-xs)}.analysis-item b{margin-left:60px}.analysis-preview{margin-top:4px}.empty-state{padding:48px 18px}.empty-state h2{font-size:24px}}
.setup-layout{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(230px,1fr);gap:40px;align-items:start}.setup-panel{padding:32px;background:var(--color-surface);border:1px solid var(--color-line);border-radius:var(--radius-card);min-width:0}.setup-panel .two-fields{align-items:start}.setup-layout .helper-panel{padding-top:28px}.valuation-panel>.btn{width:100%}.detail-image .image-fallback{position:absolute;inset:0}.prototype-inspector>div{max-height:calc(100dvh - 160px);overflow:auto}.demo-tools label{display:flex;gap:8px;align-items:center;min-height:44px;font-size:var(--font-xs)}.demo-tools input{width:18px;height:18px;accent-color:var(--color-primary)}.demo-tools .btn{font-size:var(--font-xs)}#update-region>.notice{margin:0 0 20px}.reference-row>span{min-width:0}.reference-row .text-link{font-size:var(--font-sm)}.reference-row b{flex:none}.offer-card--feature .offer-photo .image-fallback{position:absolute;inset:0}.setup-panel .field-error{font-size:var(--font-sm)}.content h2:focus{outline:none}
@media(max-width:{{layout-tablet}}){.setup-layout{grid-template-columns:1fr;gap:16px}.setup-layout .helper-panel{padding:12px 0}.setup-panel{padding:28px}.setup-steps{gap:24px}}
@media(max-width:{{layout-mobile}}){.setup-panel{padding:24px 18px}.setup-layout{gap:20px}.setup-steps{gap:14px;margin-bottom:24px;padding-bottom:24px}.setup-steps li{font-size:11px}.setup-steps li>span{width:24px;height:24px}.reference-row{flex-direction:column;gap:10px}.reference-row b{align-self:flex-end}.setup-panel h2{font-size:25px}.setup-panel form h2+p{margin-bottom:24px}.form-error a{overflow-wrap:anywhere}.analysis-item>span{min-width:0}.filter-select select{font-size:var(--font-sm)}}

.sidebar{overflow-y:auto}.nav-link{min-width:0}.nav-link>span:not(.nav-count){min-width:0;overflow-wrap:anywhere}
@media(max-width:{{layout-mobile}}){.condition-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;overflow:visible}.condition-tab{display:block;white-space:normal;line-height:1.5;text-align:left;overflow-wrap:anywhere}.condition-tab>span{display:inline-block;margin-left:5px}.sidebar{max-width:100vw}}
